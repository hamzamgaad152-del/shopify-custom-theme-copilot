<section class="product-template" data-section-id="{{ section.id }}" data-product-handle="{{ product.handle }}" data-configurator-product="{% if template.suffix == 'configurator' %}true{% else %}false{% endif %}">
  <div class="container">
    <div class="product-template__grid">
      <div class="product-gallery reveal">
        {% if product.featured_image != blank %}
          {{ product.featured_image | image_url: width: 1200 | image_tag: class: 'product-gallery__main-image', alt: product.title | escape }}
        {% else %}
          <div class="product-card__placeholder product-gallery__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {% endif %}
      </div>

      <div class="product-info reveal">
        <p class="eyebrow">Écrin sur mesure</p>
        {% if product.vendor != blank %}<p class="product-card__vendor">{{ product.vendor }}</p>{% endif %}
        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price">
          {% render 'price', product: product %}
        </div>

        <div class="product-spec-summary">
          <span>Découpé pour le modèle {{ product.title }}</span>
          <span>3 mm Plexiglas • finition noir profond</span>
        </div>

        {% form 'product', product, id: 'ProductForm', class: 'product-form' %}
          {% assign current_variant = product.selected_or_first_available_variant %}

          <input type="hidden" name="id" value="{{ current_variant.id }}" data-selected-variant>

          {% unless product.has_only_default_variant %}
            <div class="product-form__variant-selector" data-option-selectors>
              {% for option in product.options_with_values %}
                <div class="product-form__option">
                  <label for="Option-{{ section.id }}-{{ forloop.index }}" class="product-form__label">{{ option.name }}</label>
                  <select id="Option-{{ section.id }}-{{ forloop.index }}" class="product-form__select" data-product-option data-option-position="{{ option.position }}">
                    {% for value in option.values %}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>{{ value }}</option>
                    {% endfor %}
                  </select>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          {% if template.suffix == 'configurator' %}
            <div class="product-form__dimensions" data-digit-dimensions>
              <p class="product-form__label">Dimensions (cm)</p>
              <div class="dimension-grid">
                <label>Longueur<input type="number" min="5" max="200" step="1" value="20" data-digit-dimension="length"></label>
                <label>Largeur<input type="number" min="5" max="200" step="1" value="16" data-digit-dimension="width"></label>
                <label>Hauteur<input type="number" min="5" max="200" step="1" value="20" data-digit-dimension="height"></label>
              </div>
              <p class="builder-price" data-digit-price aria-live="polite">Prix estimé : 0,00 €</p>
            </div>
          {% endif %}

          <div class="product-form__quantity-wrapper">
            <label for="Quantity-{{ section.id }}" class="product-form__label">Quantité</label>
            <input type="hidden" name="quantity" id="Quantity-{{ section.id }}" value="1" data-product-quantity>
          </div>

          <div class="product-form__actions">
            <button type="submit" name="add" class="button button--primary button--full" data-add-to-cart>
              {% if current_variant.available %}Ajouter au panier{% else %}Rupture de stock{% endif %}
            </button>
          </div>

          {% if section.settings.show_dynamic_checkout and template.suffix != 'configurator' %}
            <div class="product-form__payment">{{ form | payment_button }}</div>
          {% endif %}
        {% endform %}

        {% if product.description != blank %}
          <div class="product-info__description rte">
            {{ product.description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    }
  ]
}
{% endschema %}
