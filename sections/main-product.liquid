<section class="product-template" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="product-template__grid">
      <div class="product-gallery reveal">
        {% if product.featured_image != blank %}
          {{ product.featured_image | image_url: width: 1200 | image_tag: class: 'product-gallery__main-image', alt: product.title | escape }}
        {% else %}
          <div class="product-card__placeholder product-gallery__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {% endif %}
      </div>

      <div class="product-info reveal">
        <p class="eyebrow">Écrin sur mesure</p>
        {% if product.vendor != blank %}<p class="product-card__vendor">{{ product.vendor }}</p>{% endif %}
        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price">
          {% render 'price', product: product %}
        </div>

        <div class="product-spec-summary">
          <span>Découpé pour le modèle {{ product.title }}</span>
          <span>3 mm Plexiglas • finition noir profond</span>
        </div>

        {% form 'product', product, id: 'ProductForm', class: 'product-form' %}
          {% assign current_variant = product.selected_or_first_available_variant %}

          {% if product.has_only_default_variant %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% else %}
            <div class="product-form__variant-selector">
              <label for="Option-{{ section.id }}" class="product-form__label">Finition</label>
              <select name="id" id="Option-{{ section.id }}" class="product-form__select" data-variant-select>
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% if variant == current_variant %}selected="selected"{% endif %} {% unless variant.available %}disabled="disabled"{% endunless %} data-price="{{ variant.price | money }}" data-available="{{ variant.available }}">
                    {{ variant.title }} - {{ variant.price | money }} {% unless variant.available %}(Indisponible){% endunless %}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endif %}

          <div class="product-form__quantity-wrapper">
            <label for="Quantity-{{ section.id }}" class="product-form__label">Quantité</label>
            <input type="number" name="quantity" id="Quantity-{{ section.id }}" class="product-form__quantity-input" value="1" min="1">
          </div>

          <div class="product-form__actions">
            <button type="submit" name="add" class="button button--primary button--full" data-add-to-cart>
              {% if current_variant.available %}Ajouter au panier{% else %}Rupture de stock{% endif %}
            </button>
          </div>

          {% if section.settings.show_dynamic_checkout %}
            <div class="product-form__payment">{{ form | payment_button }}</div>
          {% endif %}
        {% endform %}

        {% if product.description != blank %}
          <div class="product-info__description rte">
            {{ product.description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    }
  ]
}
{% endschema %}
