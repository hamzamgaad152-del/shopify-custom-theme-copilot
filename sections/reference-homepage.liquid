<section class="reference-homepage">
  <div class="container reference-homepage__hero">
    <div class="reference-homepage__hero-copy">
      <div class="reference-homepage__eyebrow-wrap">
        <span class="reference-homepage__eyebrow">Handcrafted Display Cases</span>
      </div>

      <h1>Elevate Your<br>Display</h1>

      <p class="reference-homepage__lead">
        Museum-grade acrylic cases with precision aluminum joints — built to protect and showcase what you collect.
      </p>

      <div class="reference-homepage__actions">
        <a class="button button--primary reference-homepage__cta" href="/collections/all">Shop Display Cases</a>
        <a class="button button--secondary reference-homepage__cta" href="{{ pages['sur-mesure'].url | default: '/pages/sur-mesure' }}">Build a Custom Case</a>
      </div>

      <ul class="reference-homepage__benefits">
        <li>Dust-Proof Seal</li>
        <li>UV-Protected Acrylic</li>
        <li>1cm Solid Aluminum Corners</li>
      </ul>
    </div>

    <div class="reference-homepage__hero-visual" aria-label="Display case preview">
      <div class="reference-case">
        <div class="reference-case__frame"></div>
        <div class="reference-case__base"></div>
        <div class="reference-case__model"></div>
      </div>
    </div>
  </div>

  <div class="reference-homepage__divider"></div>

  <div class="container reference-homepage__section reference-homepage__section--categories">
    <div class="reference-homepage__section-tag">Browse Categories</div>
    <h2>Shop by Collection</h2>
    <p>Precision-built cases for every kind of collector.</p>

    <div class="reference-homepage__collection-grid">
      <article class="reference-homepage__collection-card reference-homepage__collection-card--lego">
        <div class="reference-homepage__collection-visual reference-homepage__collection-visual--lego"></div>
        <div class="reference-homepage__collection-meta">
          <h3>LEGO Display Cases</h3>
          <a href="/collections/lego">Shop Now <span>→</span></a>
        </div>
      </article>

      <article class="reference-homepage__collection-card reference-homepage__collection-card--funko">
        <div class="reference-homepage__collection-visual reference-homepage__collection-visual--funko"></div>
        <div class="reference-homepage__collection-meta">
          <h3>Funko Pop Protectors</h3>
          <a href="/collections/funko-pop">Shop Now <span>→</span></a>
        </div>
      </article>

      <article class="reference-homepage__collection-card reference-homepage__collection-card--cards">
        <div class="reference-homepage__collection-visual reference-homepage__collection-visual--cards"></div>
        <div class="reference-homepage__collection-meta">
          <h3>Trading Card Frames</h3>
          <a href="/collections/all">Shop Now <span>→</span></a>
        </div>
      </article>

      <article class="reference-homepage__collection-card reference-homepage__collection-card--custom">
        <div class="reference-homepage__collection-visual reference-homepage__collection-visual--custom"></div>
        <div class="reference-homepage__collection-meta">
          <h3>Custom Sizes</h3>
          <a href="{{ pages['sur-mesure'].url | default: '/pages/sur-mesure' }}">Shop Now <span>→</span></a>
        </div>
      </article>
    </div>
  </div>

  <div class="reference-homepage__divider"></div>

  <div class="container reference-homepage__section reference-homepage__section--features">
    <div class="reference-homepage__section-tag">Why Acrilux</div>
    <h2>Engineered for Collectors</h2>
    <p>Precision-crafted details that protect and elevate every piece.</p>

    <div class="reference-homepage__feature-grid">
      <article class="reference-homepage__feature-card">
        <div class="reference-homepage__feature-icon reference-homepage__feature-icon--shield">✓</div>
        <h3>Dust-Free Protection</h3>
        <p>Fully sealed acrylic panels keep every piece pristine.</p>
      </article>

      <article class="reference-homepage__feature-card">
        <div class="reference-homepage__feature-icon reference-homepage__feature-icon--laser">×</div>
        <h3>Precision Laser-Cut Acrylic</h3>
        <p>Cut to exact tolerances for a flawless museum-grade fit.</p>
      </article>

      <article class="reference-homepage__feature-card">
        <div class="reference-homepage__feature-icon reference-homepage__feature-icon--tool">⚒</div>
        <h3>Easy Tool-Free Assembly</h3>
        <p>Solid aluminum corner connectors snap together in minutes.</p>
      </article>

      <article class="reference-homepage__feature-card">
        <div class="reference-homepage__feature-icon reference-homepage__feature-icon--ruler">▭</div>
        <h3>Custom Sizing Options</h3>
        <p>Built to the exact dimensions of your collection.</p>
      </article>
    </div>
  </div>

  <div class="reference-homepage__divider"></div>

  <div class="container reference-homepage__section reference-homepage__section--products">
    <div class="reference-homepage__section-tag reference-homepage__section-tag--dark">Best-Selling Display Cases</div>
    <h2>Best-Selling Display Cases</h2>
    <p>Handcrafted, precision-fit, and ready to protect your collection.</p>

    {% assign featured_collection = collections[section.settings.featured_collection] %}
    {% if featured_collection != blank and featured_collection.products.size > 0 %}
      <div class="reference-homepage__product-grid">
        {% for product in featured_collection.products limit: 4 %}
          <article class="reference-homepage__product-card">
            <a href="{{ product.url }}" class="reference-homepage__product-card-link">
              {% if product.featured_image != blank %}
                <div class="reference-homepage__product-visual">
                  {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'reference-homepage__product-image', alt: product.title | escape }}
                </div>
              {% else %}
                <div class="reference-homepage__product-visual reference-homepage__product-visual--placeholder"></div>
              {% endif %}
            </a>
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <div class="reference-homepage__product-meta">
              {% if product.tags contains 'dust-proof' %}<span class="reference-homepage__chip">100% Dust-Proof</span>{% endif %}
              {% if product.tags contains 'uv' %}<span class="reference-homepage__chip">UV Protection</span>{% endif %}
              {% if product.tags contains 'aluminum' %}<span class="reference-homepage__chip">1cm Aluminum Corners</span>{% endif %}
            </div>
            <div class="reference-homepage__rating">★★★★★ <span>({{ product.metafields.reviews.rating_count | default: product.variants.size | plus: 120 }})</span></div>
            <div class="reference-homepage__price">{{ product.price | money }}</div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="reference-homepage__product-grid reference-homepage__product-grid--empty">
        <div class="reference-homepage__empty-msg">Add products to your collection to populate this section.</div>
      </div>
    {% endif %}

    <div class="reference-homepage__button-row">
      <a class="button button--primary reference-homepage__cta reference-homepage__cta--small" href="/collections/all">Shop All Cases</a>
    </div>
  </div>

  <div class="reference-homepage__divider"></div>

  <div class="container reference-homepage__section reference-homepage__section--vault">
    <div class="reference-homepage__section-tag reference-homepage__section-tag--dark">#ACRILUXCOLLECTORS</div>
    <h2>The Collector’s Vault</h2>
    <p>See how collectors around the world are showcasing their sets. Tag <a href="/collections/all">@acrilux</a> to be featured.</p>

    <div class="reference-homepage__vault-grid">
      <article class="reference-homepage__vault-item reference-homepage__vault-item--rose">
        <div class="reference-homepage__vault-tag">@brick.vault</div>
        <span>2.4k</span>
      </article>

      <article class="reference-homepage__vault-item reference-homepage__vault-item--amber">
        <div class="reference-homepage__vault-tag">@popshelf.co</div>
        <span>1.8k</span>
      </article>

      <article class="reference-homepage__vault-item reference-homepage__vault-item--blue">
        <div class="reference-homepage__vault-tag">@gradedgems</div>
        <span>3.1k</span>
      </article>

      <article class="reference-homepage__vault-item reference-homepage__vault-item--magenta">
        <div class="reference-homepage__vault-tag">@vaultkeeper</div>
        <span>5.6k</span>
      </article>
    </div>
  </div>

  <div class="reference-homepage__divider"></div>

  <div class="container reference-homepage__section reference-homepage__section--reviews">
    <div class="reference-homepage__section-tag">Collector Reviews</div>
    <h2>Trusted by Serious Collectors</h2>
    <p>Thousands of AFOLs, TCG collectors, and figure enthusiasts protect their collections with us.</p>

    <div class="reference-homepage__review-grid">
      <article class="reference-homepage__review-card">
        <div class="reference-homepage__stars">★★★★★</div>
        <blockquote>
          The aluminum corners feel bulletproof — genuinely premium. My UCS sets are finally dust-free and the whole shelf looks like a museum exhibit now.
        </blockquote>
        <div class="reference-homepage__reviewer">Marcus Reyes</div>
        <div class="reference-homepage__review-role">AFOL, LEGO Technic Collector</div>
      </article>

      <article class="reference-homepage__review-card">
        <div class="reference-homepage__stars">★★★★★</div>
        <blockquote>
          Assembly took maybe five minutes with zero tools. The crystal-clear panels make my Grils pop, and dust hasn’t touched a single Pop since.
        </blockquote>
        <div class="reference-homepage__reviewer">Dani Okafor</div>
        <div class="reference-homepage__review-role">Funko Pop Collector</div>
      </article>

      <article class="reference-homepage__review-card">
        <div class="reference-homepage__stars">★★★★★</div>
        <blockquote>
          As someone who invests in graded slabs, protection is everything. These cases are UV-safe, air-tight, and elevated my PSA collection into a real display.
        </blockquote>
        <div class="reference-homepage__reviewer">Priya Anand</div>
        <div class="reference-homepage__review-role">PSA Card Investor</div>
      </article>
    </div>
  </div>

  <div class="reference-homepage__divider"></div>

  <div class="container reference-homepage__section reference-homepage__section--final">
    <div class="reference-homepage__final-badge">The final word in display</div>
    <div class="reference-homepage__final-visual" aria-hidden="true"></div>
    <h2>Your Collection Deserves<br>Better Than a Shelf</h2>
    <p>Handcrafted acrylic cases with solid aluminum hardware — built to last, designed to impress.</p>
    <div class="reference-homepage__button-row reference-homepage__button-row--final">
      <a class="button button--primary reference-homepage__cta reference-homepage__cta--large" href="/collections/all">Shop All Display Cases</a>
    </div>
    <a class="reference-homepage__secondary-link" href="{{ pages['sur-mesure'].url | default: '/pages/sur-mesure' }}">Design a Custom Case <span>→</span></a>
  </div>
</section>

{% schema %}
{
  "name": "Reference homepage",
  "settings": [
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured products collection"
    }
  ]
}
{% endschema %}
