<section class="bespoke-builder" data-bespoke-builder data-pricing-url="{{ 'custom-pricing.json' | asset_url }}" data-custom-product-id="{{ section.settings.custom_case_product.id | default: section.settings.custom_case_product | default: 0 }}">
  <div class="container">
    <div class="builder-hero reveal">
      <div class="builder-hero__badge">Custom Case Design</div>
      <h1>Design a case worthy of your collection.</h1>
      <p>Six faces, dix finitions, une pièce unique. Fabriquée à la main en France pour protéger ce qui compte.</p>
    </div>

    <div class="builder-shell reveal">
      <aside class="builder-preview">
        <div class="builder-preview__frame">
          <div class="builder-case" id="builderCase" aria-live="polite" aria-label="Prévisualisation du coffret sur mesure">
            <div class="builder-face builder-face--base" data-panel-face="base" data-face-label="Socle"></div>
            <div class="builder-face builder-face--back" data-panel-face="back" data-face-label="Fond"></div>
            <div class="builder-face builder-face--top" data-panel-face="top" data-face-label="Dessus"></div>
            <div class="builder-face builder-face--left" data-panel-face="left" data-face-label="Côté gauche"></div>
            <div class="builder-face builder-face--right" data-panel-face="right" data-face-label="Côté droit"></div>
            <div class="builder-face builder-face--front" data-panel-face="front" data-face-label="Face avant"></div>
          </div>
        </div>
        <div class="builder-preview__meta">
          <span>Largeur <strong id="previewWidth">20</strong> cm</span>
          <span>Profondeur <strong id="previewDepth">16</strong> cm</span>
          <span>Hauteur <strong id="previewHeight">20</strong> cm</span>
        </div>
      </aside>

      <div class="builder-main">
        <div class="builder-progress" aria-label="Progression du devis">
          <span class="builder-progress__bar" id="builderProgressBar"></span>
        </div>

        <form class="builder-form" id="bespokeForm" novalidate>
          <div class="builder-step is-active" data-step="0">
            <h2>Étape 1 · L'objet</h2>
            <label class="field-label" for="objectName">Nom de la pièce</label>
            <input id="objectName" name="object" type="text" placeholder="Une 911 en Lego, les crampons de mon père..." value="">
            <div class="builder-price" id="builderPriceEstimate">Estimation : 0,00 €</div>
            <div class="builder-actions">
              <button type="button" class="button button--primary next-step">Commencer</button>
            </div>
          </div>

          <div class="builder-step" data-step="1">
            <h2>Étape 2 · Les dimensions</h2>
            <div class="dimension-grid">
              <div class="dimension-field">
                <label for="widthInput">Largeur</label>
                <div class="stepper">
                  <button type="button" class="stepper-btn" data-action="decrease" data-target="width">−</button>
                  <input id="widthInput" name="width" type="number" min="20" max="40" step="1" value="20">
                  <button type="button" class="stepper-btn" data-action="increase" data-target="width">+</button>
                </div>
              </div>
              <div class="dimension-field">
                <label for="depthInput">Profondeur</label>
                <div class="stepper">
                  <button type="button" class="stepper-btn" data-action="decrease" data-target="depth">−</button>
                  <input id="depthInput" name="depth" type="number" min="16" max="34" step="1" value="16">
                  <button type="button" class="stepper-btn" data-action="increase" data-target="depth">+</button>
                </div>
              </div>
              <div class="dimension-field">
                <label for="heightInput">Hauteur</label>
                <div class="stepper">
                  <button type="button" class="stepper-btn" data-action="decrease" data-target="height">−</button>
                  <input id="heightInput" name="height" type="number" min="20" max="40" step="1" value="20">
                  <button type="button" class="stepper-btn" data-action="increase" data-target="height">+</button>
                </div>
              </div>
            </div>
            <p class="helper-text">Le prix est calculé à partir du volume total, avec un surcoût de 5 € pour chaque panneau personnalisé.</p>
            <div class="builder-actions">
              <button type="button" class="button button--secondary prev-step">Retour</button>
              <button type="button" class="button button--primary next-step">Suivant</button>
            </div>
          </div>

          <div class="builder-step" data-step="2">
            <h2>Étape 3 · Les panneaux</h2>
            <div class="panel-selector">
              {% assign panel_names = 'Socle,Fond,Dessus,Côté gauche,Côté droit,Face avant' | split: ',' %}
              {% for panel in panel_names %}
                <div class="panel-row">
                  <label>{{ panel }}</label>
                  <div class="swatch-row" data-panel-group="{{ panel | handle }}">
                    {% assign colors = 'Transparent,Noir profond,Fumé,Blanc opale,Bleu nuit,Rouge carmin,Vert racing,Or miroir,Argent miroir' | split: ',' %}
                    {% for color in colors %}
                      <label class="swatch-option">
                        <input type="radio" name="panel_{{ panel | handle }}" value="{{ color | handleize }}" {% if forloop.first %}checked{% endif %}>
                        <span class="swatch" data-color="{{ color | handleize }}" title="{{ color }}"></span>
                      </label>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
            <div class="builder-actions">
              <button type="button" class="button button--secondary prev-step">Retour</button>
              <button type="button" class="button button--primary next-step">Suivant</button>
            </div>
          </div>

          <div class="builder-step" data-step="3">
            <h2>Étape 4 · Les coins</h2>
            <div class="corner-selector">
              <label class="corner-option">
                <input type="radio" name="corner_type" value="plastic" checked>
                <span>Coins en plexiglass + vis transparentes</span>
                <small>Standard · 0,00 €</small>
              </label>
              <label class="corner-option">
                <input type="radio" name="corner_type" value="metal">
                <span>Coins métalliques premium</span>
                <small>+ 9,99 €</small>
              </label>
            </div>
            <div class="builder-actions">
              <button type="button" class="button button--secondary prev-step">Retour</button>
              <button type="button" class="button button--primary next-step">Suivant</button>
            </div>
          </div>

          <div class="builder-step" data-step="4">
            <h2>Étape 5 · Récapitulatif</h2>
            <div class="summary-box">
              <div>
                <span class="muted">Objet</span>
                <strong id="summaryObject">—</strong>
              </div>
              <div>
                <span class="muted">Dimensions</span>
                <strong id="summaryDimensions">—</strong>
              </div>
              <div>
                <span class="muted">Panneaux</span>
                <strong id="summaryPanels">—</strong>
              </div>
              <div>
                <span class="muted">Coins</span>
                <strong id="summaryOptions">—</strong>
              </div>
              <div>
                <span class="muted">Prix estimé</span>
                <strong id="summaryPrice">0,00 €</strong>
              </div>
            </div>
            <div class="builder-actions">
              <button type="button" class="button button--secondary prev-step">Retour</button>
              <button type="button" class="button button--primary" id="copyLinkButton">Copier le lien de ma configuration</button>
            </div>
            <div class="builder-actions builder-actions--stacked">
              <button type="submit" class="button button--primary" id="addToCartButton">Ajouter au panier</button>
            </div>
            <p class="success-note" id="builderNotice" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bespoke builder",
  "settings": [
    {
      "type": "product",
      "id": "custom_case_product",
      "label": "Produit personnalisé à ajouter au panier"
    }
  ]
}
{% endschema %}
