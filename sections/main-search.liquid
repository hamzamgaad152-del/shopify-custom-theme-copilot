<section class="search-page" style="padding: 48px 0;">
  <div class="container">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 40px;">
      <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 20px;">
        {%- if search.performed -%}
          Search Results for "{{ search.terms | escape }}"
        {%- else -%}
          {{ 'general.search' | t }}
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 8px;">
        <input 
          type="search" 
          name="q" 
          value="{{ search.terms | escape }}" 
          placeholder="{{ 'header.search_placeholder' | t }}" 
          class="product-form__select"
          style="flex-grow: 1;"
        >
        <button type="submit" class="button button--primary">
          {{ 'general.search' | t }}
        </button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <div class="product-card" style="padding: 16px; border: 1px solid var(--color-border);">
                <h3 class="product-card__title">
                  <a href="{{ item.url }}">{{ item.title }}</a>
                </h3>
                <p style="font-size: 0.9rem; color: var(--color-secondary);">
                  {{ item.content | strip_html | truncatewords: 20 }}
                </p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div style="text-align: center; padding: 40px 0;">
          <p style="font-size: 1.15rem; color: var(--color-secondary);">No results found for "{{ search.terms | escape }}".</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search Page",
  "settings": []
}
{% endschema %}
